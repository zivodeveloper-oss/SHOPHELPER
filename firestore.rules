rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(shopId) {
      return signedIn() && exists(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)).data.status == 'active';
    }
    function role(shopId) { return get(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)).data.role; }
    function can(shopId, permission) {
      return member(shopId) && (role(shopId) == 'owner' || get(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)).data.permissions[permission] == true || get(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)).data.permissions.all == true);
    }
    match /users/{uid} {
      allow read, update: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      match /memberships/{shopId} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    }
    match /shops/{shopId} {
      allow read: if member(shopId);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if member(shopId) && role(shopId) == 'owner';
      match /members/{uid} {
        allow read: if member(shopId);
        allow write: if false; // membership lifecycle is server-managed by callable Functions
      }
      match /data/{document=**} {
        allow read: if can(shopId, 'viewDashboard') || can(shopId, 'billing') || can(shopId, 'inventory') || can(shopId, 'customers') || can(shopId, 'reports');
        allow create, update: if can(shopId, 'editData') || can(shopId, 'billing') || can(shopId, 'inventory') || can(shopId, 'customers');
        allow delete: if role(shopId) == 'owner';
      }
      match /auditLogs/{logId} { allow read: if can(shopId,'viewAudit'); allow write: if false; }
      match /invitations/{inviteId} { allow read: if member(shopId); allow write: if false; }
    }
    match /userShops/{uid}/memberships/{shopId} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
  }
}